---
import '../styles/modernist.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Aditya Chandramouli Vadali — perception and robotic vision. Topological mapping and end-to-end learning for indoor navigation.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Aditya Chandramouli Vadali" />
    <meta name="keywords" content="robotics, perception, computer vision, robot navigation, topological mapping, IROS, CoRL" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
